  subgraph FOUNDATIONS["0 · PRODUCT CONSTRAINTS AND TECHNOLOGY FOUNDATION"]
    direction LR
    INPUT_GATE["Product constraint:<br/><b>operate on a real developer workspace from a terminal</b>"]:::phase
    STACK_PY["Python 3.12–3.13<br/>asyncio control plane · native provider SDKs"]:::foundation
    STACK_UI["Textual + Rich<br/>event-driven terminal UI"]:::foundation
    STACK_DATA["SQLite + JSON<br/>local transactional and inspectable state"]:::foundation
