  INPUT_GATE ==> USER_INPUT

  subgraph STAGE1["1 · RECEIVE INTENT, RESOLVE THE WORKSPACE, AND CHOOSE THE CONTRACT"]
    direction LR
    USER_INPUT["Developer input<br/>Textual composer · piped stdin · CLI arguments"]:::external
